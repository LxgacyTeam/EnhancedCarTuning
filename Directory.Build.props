<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">REPLACE_TO_YOUR_GAMEDIR</GameDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">game_Data</GameDataDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\$(GameDataDir)\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx\core</BepInExDir>
  </PropertyGroup>
</Project>
