<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ResourcesPlatform Condition="'$(ResourcesPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</ResourcesPlatform>
    <ResourcesPlatform Condition="'$(ResourcesPlatform)' == ''">Windows</ResourcesPlatform>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\MadOut2_BigCityOnline</GameDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">game_Data</GameDataDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\$(GameDataDir)\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx\core</BepInExDir>
  </PropertyGroup>
</Project>
